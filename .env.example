# =====================================================================
# PROYECTO SADIGUA - CONFIGURACIÓN DEL SISTEMA
# =====================================================================

# Proveedor activo del Motor Cognitivo: 'gemini' o 'local'
LLM_PROVIDER=gemini

# Configuración Modo Gemini (Cloud Híbrido)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Configuración Modo Local Soberano (Ollama / GGUF)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:14b-instruct
LOCAL_API_KEY=ollama

# Cartucho de Conocimiento Activo
ACTIVE_CARTRIDGE=legal_co

# Configuración de Memoria "Cerebro Obsidiano"
VAULT_PATH=./vault
STORAGE_PATH=./data

# RAG & Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.60

# Servidor Web & Gateway
PORT=7837
HOST=0.0.0.0
